# ====================================================================
# TTS WebUI Workbench Environment Variables
# Copy this file to '.env' and fill in your details.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL!
# ====================================================================

# Port for the FastAPI backend (default: 8000)
PORT=8000
HOST=127.0.0.1

# Boson AI API Key (optional; Higgs TTS stays disabled when this is empty)
# Get your API key from https://www.boson.ai/
BOSON_API_KEY=

# Translation settings
TRANSLATION_PROVIDER=openai_compatible
TRANSLATION_API_BASE=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
